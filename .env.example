# KrishiSaathi Environment Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# Security & CORS (Comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60

# Database (SQLite by default, compatible with PostgreSQL)
DATABASE_URL=sqlite:///app/krishi_saathi.db

# Hardware & Model Acceleration
# MODEL_DEVICE=cpu
# MODEL_DEVICE=cuda

# Weather Provider
WEATHER_PROVIDER=open-meteo
WEATHER_CACHE_TTL_SECONDS=1800
